[Unit]
Description=Waydroid Bluetooth host bridge (BlueZ client)
Documentation=https://github.com/isyourbrainfoss/waydroid-host-stack/blob/main/docs/pmOS-setup.md
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
# Installers rewrite this path to $BINDIR (image-based default:
# /var/lib/waydroid-host-stack/bin). Distro packages / sysext keep /usr/bin.
ExecStart=/usr/bin/waydroid-bt-host --socket /run/waydroid-bt/host.sock
# If a Waydroid session was already running before this bridge instance
# started (manual restart / crash restart), restart the session user unit so
# the guest reconnects to the new bridge. Skips at boot/first start; debounced.
# "-": never fails the bridge; "+": runs outside the sandbox below (needs
# systemctl --user -M). Installers rewrite @SBINDIR@.
# WHS_USER: rendered at install (empty -> helper resolves via lib/paths.sh).
Environment=WHS_USER=@WAYDROID_USER@
ExecStartPost=-+@SBINDIR@/waydroid-bt-session-restart.sh
Restart=on-failure
RestartSec=2
# /run/waydroid-bt is bind-mounted into the Waydroid container. Keep the
# directory (same inode) across daemon restarts, otherwise the guest's bind
# mount points at a deleted directory until the container restarts.
RuntimeDirectory=waydroid-bt
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# Hardening. The daemon talks to org.bluez over the D-Bus system bus
# (bluer, "bluetoothd" feature) and serves a Unix socket. The only raw
# Bluetooth socket is the kernel mgmt control channel (AF_BLUETOOTH, needs
# CAP_NET_ADMIN) for passive LE auto-connect (host/src/bluez/mgmt.rs:
# Add/Remove Device only). No HCI user channel, no L2CAP, no netlink.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/run/waydroid-bt
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH

[Install]
WantedBy=multi-user.target
