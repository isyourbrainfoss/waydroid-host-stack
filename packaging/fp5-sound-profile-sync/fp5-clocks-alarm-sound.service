[Unit]
Description=FP5: play GNOME Clocks alarms when feedbackd TriggerFeedback is broken
After=graphical-session.target pipewire-pulse.service
PartOf=graphical-session.target
Wants=pipewire-pulse.service

[Service]
Type=simple
ExecStart=%h/.local/bin/fp5-clocks-alarm-sound run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
