[Unit]
Description=Waydroid host GPS forward (GeoClue / last-known → guest)
After=default.target
# Inject skips until Waydroid guest is fully booted.

[Service]
Type=simple
# Runner is generated by `waydroid-gps-forward enable` into $XDG_RUNTIME_DIR;
# this unit is a template for installers that place a static ExecStart.
ExecStart=%h/.local/bin/waydroid-gps-forward once-loop
Restart=always
RestartSec=3
Environment=PATH=%h/.local/bin:/usr/bin:/bin
Environment=HOME=%h

[Install]
WantedBy=default.target
