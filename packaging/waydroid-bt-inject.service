[Unit]
Description=Inject waydroid-bt host socket into Waydroid LXC (runtime fallback)
Documentation=https://github.com/isyourbrainfoss/waydroid-host-stack/blob/main/docs/pmOS-setup.md
After=waydroid-container.service waydroid-bt-host.service
Wants=waydroid-bt-host.service

[Service]
Type=oneshot
# Primary path is the lxc.include mount (waydroid-bt-lxc-include.service).
# This oneshot (timer-driven, root) re-binds only if the guest lost the socket.
# Installers rewrite @SBINDIR@.
ExecStart=@SBINDIR@/waydroid-bt-session-hook.sh
RemainAfterExit=no
